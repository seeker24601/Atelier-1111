{
  "name": "atelier-1111",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "BYOK image and video generation for OpenRouter, running on your own machine.",
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "dev": "concurrently -n API,WEB -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:web": "vite",
    "vault": "node --env-file-if-exists=.env scripts/sync-vault.mjs",
    "test": "node --test \"server/*.test.js\" \"src/*.test.js\" \"src/state/*.test.js\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=22.5"
  },
  "overrides": {
    "shell-quote": "1.12.0"
  }
}
