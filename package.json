{
  "name": "atelier-1111",
  "version": "0.3.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "BYOK image and video generation with your own provider keys, running on your own machine.",
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "dev": "concurrently -n API,WEB -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:web": "vite",
    "vault": "node --env-file-if-exists=.env scripts/sync-vault.mjs",
    "test": "node --test \"server/**/*.test.js\" \"src/*.test.js\" \"src/state/*.test.js\" \"mcp/*.test.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "mcp": "node mcp/index.js"
  },
  "dependencies": {
    "@fontsource/silkscreen": "5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai-connections": "^0.4.0",
    "express": "^4.21.2",
    "lucide-react": "0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=22.5"
  },
  "overrides": {
    "shell-quote": "1.12.0"
  }
}
