# Optional. The usual way to add a key is Settings in the app, which stores it
# in data/settings.json. A key here is the fallback. Keys: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENAI_API_KEY=
GEMINI_API_KEY=
# Image providers reached through AI Connections:
# XAI_API_KEY=
# FAL_KEY=
# REPLICATE_API_TOKEN=
# BFL_API_KEY=
# LUMA_API_KEY=
# ARK_API_KEY=
# PRODIA_TOKEN=

# Optional — sent as OpenRouter attribution headers
OPENROUTER_APP_TITLE=Atelier-1111
OPENROUTER_APP_URL=http://localhost:5180

# Ports. `npm start` serves everything on APP_PORT; `npm run dev` runs the API
# on API_PORT behind the Vite dev server on 5180.
APP_PORT=5180
API_PORT=8788

# The server only answers loopback host names. Add others here (comma-separated)
# only if you deliberately put it behind something else.
# ATELIER_HOSTS=atelier.local
